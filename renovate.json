{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(deps)"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "assignees": ["peipeipe"],
  "prConcurrentLimit": 5,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "minor / patch / digest はCI通過後に自動マージ",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "GitHub Actions の更新も自動マージ（メジャーを除く）",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "メジャーアップデートは手動レビュー（特にネイティブ依存は破壊的変更が入りやすい）",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    }
  ],
  "vulnerabilityAlerts": {
    "description": "脆弱性修正はスケジュールを無視して即PR・自動マージ",
    "labels": ["dependencies", "security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
